# Environment variables for Haven
# Copy this file to `.env.local` and fill in your actual API keys.
# These variables MUST be set as Environment Variables in Vercel dashboard.

# Bynara API — Primary LLM provider
# Get yours at: https://bynara.id
BYNARA_API_KEY=sk-nry-your-bynara-api-key-here

# Cerebras API — Fallback LLM provider
# Get yours at: https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk-your-cerebras-api-key-here
